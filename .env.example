PORT=4317
APP_ORIGIN=http://localhost:4317
# Optional comma-separated exact origins during a custom-domain transition.
ADDITIONAL_APP_ORIGINS=
DATABASE_URL=postgres://dutygraph_app:CHANGE_ME@127.0.0.1:55437/dutygraph
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55437/dutygraph
POSTGRES_PASSWORD=CHANGE_ME
APP_DATABASE_PASSWORD=CHANGE_ME
ENABLE_DEMO=true
# Optional Exa public research. Keep the key out of source control and chat.
EXA_API_KEY=
ENABLE_EXA_RESEARCH=false
# Encrypted account key storage: setup generates a random 32-byte hex key.
PROVIDER_ENCRYPTION_KEY=
# Hosted only: restricted application DB role, never the migration/owner role.
APP_DATABASE_URL=
CRON_SECRET=
# Optional local-only provider fallbacks. Prefer account Settings.
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
# Transcription and customer-system runtime are not implemented by flags.
